# Copy to .env.production on the VPS. Never commit real secrets.
PUBLIC_SITE_URL=https://finchnetworksltd.com
# Docker sets DATA_DIR=/data. Local development defaults to ./data.
# New estimates, orders and site visits are emailed to the business address in Settings.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://finchnetworksltd.com/api/customer/callback
# Payments stay off until MPESA_STK_ENABLED=true, and only after a live prompt has been verified.
# Safaricom must call this exact address.
MPESA_STK_ENABLED=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_PARTY_B=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://finchnetworksltd.com/api/commerce/mpesa/callback
