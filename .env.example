# Copy to .env.production on the VPS. Never commit real secrets.
PUBLIC_SITE_URL=https://finchnetworksltd.com
# Docker sets DATA_DIR=/data. Local development defaults to ./data.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://finchnetworksltd.com/api/customer/callback
# Payments remain inactive until the integration is completed.
# Set MPESA_STK_ENABLED=true only after the Safaricom callback has been verified.
MPESA_STK_ENABLED=
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_PARTY_B=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=
